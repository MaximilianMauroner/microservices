{
  "name": "tools-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "jobs/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "cd apps/artifact-publisher && bun run build",
    "lint": "bun run lint:uptime-monitor",
    "lint:uptime-monitor": "cd services/uptime-monitor && bun run lint",
    "start:artifact-publisher": "cd apps/artifact-publisher && bun run start",
    "start:field-guide-console": "cd apps/field-guide-console && bun run start",
    "start:network-console": "cd apps/network-console && bun run start",
    "start:uptime-monitor": "cd services/uptime-monitor && bun run dev",
    "test": "bun run test:artifact-publisher && bun run test:field-guide-console && bun run test:network-console && bun run test:tools-domain && bun run test:uptime-monitor",
    "test:artifact-publisher": "cd apps/artifact-publisher && bun run test",
    "test:field-guide-console": "cd apps/field-guide-console && bun run test",
    "test:network-console": "cd apps/network-console && bun run test",
    "test:tools-domain": "cd packages/tools-domain && bun run test",
    "test:uptime-monitor": "cd services/uptime-monitor && bun run test",
    "typecheck": "bun run typecheck:artifact-publisher && bun run typecheck:field-guide-console && bun run typecheck:network-console && bun run typecheck:tools-domain && bun run typecheck:uptime-monitor",
    "typecheck:artifact-publisher": "cd apps/artifact-publisher && bun run typecheck",
    "typecheck:field-guide-console": "cd apps/field-guide-console && bun run typecheck",
    "typecheck:network-console": "cd apps/network-console && bun run typecheck",
    "typecheck:tools-domain": "cd packages/tools-domain && bun run typecheck",
    "typecheck:uptime-monitor": "cd services/uptime-monitor && bun run typecheck",
    "verify": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3"
  }
}
