{
  "name": "tools-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "jobs/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:platform",
    "build:platform": "bun run --cwd packages/field-guide-console build:css && bun run --cwd apps/platform-service build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "lint": "bun run typecheck",
    "start:network-console": "cd apps/network-console && bun run start",
    "start:markdown-share": "cd apps/markdown-share && bun run dev",
    "start:platform-service": "cd apps/platform-service && bun run start",
    "start:tools-checker": "cd jobs/tools-checker && bun run start",
    "test": "bun run test:artifact-publisher && bun run test:field-guide-console && bun run test:markdown-share && bun run test:network-console && bun run test:platform-security && bun run test:platform-service && bun run test:tools-domain && bun run test:tools-checker && bun run test:tools-web",
    "test:artifact-publisher": "cd packages/artifact-publisher && bun run test",
    "test:field-guide-console": "cd packages/field-guide-console && bun run test",
    "test:markdown-share": "cd apps/markdown-share && bun run test",
    "test:network-console": "cd apps/network-console && bun run test",
    "test:platform-security": "cd packages/platform-security && bun run test",
    "test:platform-service": "cd apps/platform-service && bun run test",
    "test:tools-domain": "cd packages/tools-domain && bun run test",
    "test:tools-checker": "cd jobs/tools-checker && bun run test",
    "test:tools-web": "cd packages/tools-web && bun run test",
    "typecheck": "bun run typecheck:artifact-publisher && bun run typecheck:field-guide-console && bun run typecheck:markdown-share && bun run typecheck:network-console && bun run typecheck:platform-security && bun run typecheck:platform-service && bun run typecheck:tools-domain && bun run typecheck:suite-chrome && bun run typecheck:tools-checker && bun run typecheck:tools-web",
    "typecheck:artifact-publisher": "cd packages/artifact-publisher && bun run typecheck",
    "typecheck:field-guide-console": "cd packages/field-guide-console && bun run typecheck",
    "typecheck:markdown-share": "cd apps/markdown-share && bun run typecheck",
    "typecheck:network-console": "cd apps/network-console && bun run typecheck",
    "typecheck:platform-service": "cd apps/platform-service && bun run typecheck",
    "typecheck:platform-security": "cd packages/platform-security && bun run typecheck",
    "typecheck:tools-domain": "cd packages/tools-domain && bun run typecheck",
    "typecheck:suite-chrome": "cd packages/suite-chrome && bun run typecheck",
    "typecheck:tools-checker": "cd jobs/tools-checker && bun run typecheck",
    "typecheck:tools-web": "cd packages/tools-web && bun run typecheck",
    "verify": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "6.0.3"
  }
}
