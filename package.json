{
  "name": "microservices",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm run build:tools",
    "build:tools": "pnpm --dir services/tools/field-guide run build:css && pnpm --dir services/tools run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "start:network-console": "pnpm --dir services/network-console run start",
    "start:markdown-share": "pnpm --dir services/markdown-share run dev",
    "start:tools": "pnpm --dir services/tools run start",
    "start:status": "pnpm --dir services/tools/status run start",
    "test": "pnpm run test:publisher && pnpm run test:field-guide && pnpm run test:markdown-share && pnpm run test:network-console && pnpm run test:tools-security && pnpm run test:tools && pnpm run test:tools-domain && pnpm run test:status && pnpm run test:dashboard",
    "test:publisher": "pnpm --dir services/tools/publisher run test",
    "test:field-guide": "pnpm --dir services/tools/field-guide run test",
    "test:markdown-share": "pnpm --dir services/markdown-share run test",
    "test:network-console": "pnpm --dir services/network-console run test",
    "test:tools-security": "pnpm --dir services/tools/runtime/security run test",
    "test:tools": "pnpm --dir services/tools run test",
    "test:tools-domain": "pnpm --dir services/tools/runtime/domain run test",
    "test:status": "pnpm --dir services/tools/status run test",
    "test:dashboard": "pnpm --dir services/tools/dashboard run test",
    "typecheck": "pnpm run typecheck:publisher && pnpm run typecheck:field-guide && pnpm run typecheck:markdown-share && pnpm run typecheck:network-console && pnpm run typecheck:tools-security && pnpm run typecheck:tools && pnpm run typecheck:tools-domain && pnpm run typecheck:status && pnpm run typecheck:dashboard",
    "typecheck:publisher": "pnpm --dir services/tools/publisher run typecheck",
    "typecheck:field-guide": "pnpm --dir services/tools/field-guide run typecheck",
    "typecheck:markdown-share": "pnpm --dir services/markdown-share run typecheck",
    "typecheck:network-console": "pnpm --dir services/network-console run typecheck",
    "typecheck:tools": "pnpm --dir services/tools run typecheck",
    "typecheck:tools-security": "pnpm --dir services/tools/runtime/security run typecheck",
    "typecheck:tools-domain": "pnpm --dir services/tools/runtime/domain run typecheck",
    "typecheck:status": "pnpm --dir services/tools/status run typecheck",
    "typecheck:dashboard": "pnpm --dir services/tools/dashboard run typecheck",
    "verify": "pnpm run typecheck && pnpm run test"
  }
}
