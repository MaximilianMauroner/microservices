{
  "name": "microservices",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm run build:tools",
    "build:tools": "pnpm --dir services/tools run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v",
    "local:stack": "node --experimental-strip-types services/tools/test/runtime/local-stack-cli.ts",
    "start:network-console": "pnpm --dir services/network-console run start",
    "start:tools": "pnpm --dir services/tools run start",
    "start:status": "pnpm --dir services/tools run status:start",
    "test": "pnpm run test:scripts && pnpm run test:network-console && pnpm run test:tools",
    "test:scripts": "node --test scripts/validate-tracked-files.test.mjs",
    "test:network-console": "pnpm --dir services/network-console run test",
    "test:tools": "pnpm --dir services/tools run test",
    "typecheck": "pnpm run typecheck:network-console && pnpm run typecheck:tools",
    "typecheck:network-console": "pnpm --dir services/network-console run typecheck",
    "typecheck:tools": "pnpm --dir services/tools run typecheck",
    "validate": "node scripts/validate-tracked-files.mjs",
    "verify": "pnpm run validate && node --experimental-strip-types services/tools/test/runtime/run.ts workspace"
  }
}
