{
  "name": "@tools-platform/field-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./app": {
      "types": "./src/app.ts",
      "import": "./src/app.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./src/auth.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    },
    "./http": {
      "types": "./src/http.ts",
      "import": "./src/http.ts"
    },
    "./repository": {
      "types": "./src/repository.ts",
      "import": "./src/repository.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build:css && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/review.css -o ./public/review.css --minify",
    "db:push-sqlite": "bun src/push-sqlite.ts",
    "db:import-postgres": "bun src/import-postgres.ts",
    "db:push-postgres": "bun src/push-postgres.ts production",
    "db:push-postgres:test": "bun src/push-postgres.ts test",
    "db:recover-postgres": "bun src/recover-postgres.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && bun test --timeout 15000 test/sqlite-repository.bun.test.ts test/sqlite-decision-records.bun.test.ts test/transfer.bun.test.ts",
    "verify": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@tools-platform/suite-chrome": "workspace:*",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.2",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "^4.1.9"
  }
}
