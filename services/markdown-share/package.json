{
  "name": "markdown-share",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "deploy": "wrangler deploy",
    "deploy:production": "convex deploy --cmd 'heavy-check -- pnpm run build' --cmd-url-env-var-name VITE_CONVEX_URL && wrangler deploy",
    "dev": "vite --host 0.0.0.0",
    "lint": "eslint convex",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@convex-dev/presence": "0.4.0",
    "@convex-dev/prosemirror-sync": "0.2.5",
    "@tiptap/core": "3.29.2",
    "@tiptap/extension-code-block": "3.29.2",
    "@tiptap/extension-document": "3.29.2",
    "@tiptap/extension-text": "3.29.2",
    "@tiptap/extensions": "3.29.2",
    "@tiptap/react": "3.29.2",
    "convex": "1.42.3",
    "diff": "^9.0.0",
    "prosemirror-collab": "1.3.1",
    "prosemirror-model": "1.25.4",
    "prosemirror-transform": "1.12.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^2.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "convex-test": "0.0.53",
    "eslint": "^10.8.0",
    "jsdom": "30.0.1",
    "typescript-eslint": "^8.65.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
