{
  "name": "@tools-platform/artifact-publisher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:backfill": "tsx ../database/002_backfill_artifact_metadata.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@tools-platform/suite-chrome": "workspace:*",
    "busboy": "1.6.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/busboy": "1.5.4",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "tsx": "^4.20.6",
    "vitest": "^4.1.9"
  }
}
