{
  "name": "@tools-platform/tools-checker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "seed-local": "tsx src/local-seed.ts",
    "markdown-mock": "tsx src/markdown-mock.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.717.0",
    "@tools-platform/domain": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
  }
}
