{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./platform/ui/*"]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "platform/**/*.ts",
    "platform/**/*.tsx",
    "products/**/*.ts",
    "products/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx"
  ]
}
