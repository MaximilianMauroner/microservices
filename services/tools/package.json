{
  "name": "@tools-platform/service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#domain": "./platform/domain/index.ts",
    "#security": "./platform/security/index.ts",
    "#suite-chrome": "./platform/suite-chrome/index.js",
    "#dashboard": "./products/dashboard/src/index.ts",
    "#dashboard/products": "./products/dashboard/products.ts",
    "#status": "./products/status/index.ts",
    "#publisher": "./products/publisher/index.ts"
  },
  "scripts": {
    "build": "NODE_ENV=production vite build",
    "db:push-postgres": "tsx platform/database/push-postgres.ts production",
    "db:push-postgres:preview": "tsx platform/database/push-postgres.ts preview",
    "db:push-postgres:development": "TOOLS_DEVELOPMENT_SCHEMA_PUSH_CONFIRM=tools-platform-development node --env-file-if-exists=.env.local --import tsx platform/database/push-postgres.ts development",
    "db:push-postgres:test": "tsx platform/database/push-postgres.ts test",
    "feedback:encrypt-existing": "tsx products/feedback/encrypt-existing.ts",
    "dev": "vite dev",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test test/products/publisher/release-paired-backup.test.mjs",
    "test:money-postgres": "node --experimental-strip-types test/harness/run.ts money-postgres",
    "status:start": "tsx products/status/cli.ts",
    "status:seed-local": "tsx products/status/local-seed.ts",
    "publisher:upload-direct": "tsx products/publisher/scripts/upload-direct.ts",
    "publisher:db-backfill": "tsx platform/database/002_backfill_artifact_metadata.ts"
  },
