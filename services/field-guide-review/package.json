{
  "name": "field-guide-review",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build:css && tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i ./src/review.css -o ./public/review.css --minify",
    "db:plan": "drizzle-kit push --explain --verbose",
    "db:push": "drizzle-kit push",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-beta.22",
    "express": "^4.21.2",
    "jose": "^6.1.3",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "1.0.0-beta.22",
    "supertest": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  }
}
