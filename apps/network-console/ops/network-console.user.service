[Unit]
Description=Tools Platform network console user service example
After=default.target

[Service]
Type=simple
WorkingDirectory=/opt/tools-platform/apps/network-console
Environment=PORT=80
ExecStart=/usr/local/bin/bun run start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
